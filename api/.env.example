APP_NAME=Vault
APP_VERSION=0.0.1

DB_HOST=localhost
DB_PORT=5432
DB_NAME=vault
DB_PASSWORD=changeme
DB_USER=vault_user
DB_SSL=false

APP_PORT=8080
JWT_SECRET=cambiar-por-un-secreto-largo-y-aleatorio
CORS_ORIGIN=*
COOKIE_SECURE=false

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: si no se define, se usa amqp://guest:guest@localhost:5672/
# Usado solo para asset.updated (recalculo de perfil ML). Si RabbitMQ no
# está disponible, la API sigue funcionando normal para activos.
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# Opcional: si no se define, se usa http://localhost:8006
# URL de vault-ai-service para moderar posts/comentarios/reseñas ANTES de
# guardarlos. Si este servicio no responde, la publicación se rechaza
# (política: bloquear si no se puede verificar el contenido).
NLP_SERVICE_URL=http://localhost:8006

# Opcional: si no se define, se usa http://localhost:8005
# URL de payment/ (servicio separado) -- se usa para verificar que un
# comprador tenga al menos un pedido liberado con un vendedor antes de
# dejarlo publicar una reseña sobre ese vendedor.
PAYMENT_SERVICE_URL=http://localhost:8005

# Opcional: si no se define, las notificaciones push (FCM) no se envían
# (la app sigue funcionando normal, solo sin push). Contenido JSON completo
# de la cuenta de servicio -- Firebase Console -> Configuración del proyecto
# -> Cuentas de servicio -> Generar nueva clave privada. Debe ser el mismo
# proyecto de Firebase que usa el cliente Flutter (google-services.json).
FIREBASE_SERVICE_ACCOUNT_KEY=
